# Пароль входа на сайт
NUXT_APP_PASSWORD=
# Секрет шифрования сессий (32+ символов): openssl rand -base64 32
NUXT_SESSION_PASSWORD=
# OAuth-токен Яндекс Музыки
NUXT_YANDEX_TOKEN=
# Spotify: https://developer.spotify.com/dashboard → ваше приложение → Settings
NUXT_SPOTIFY_CLIENT_ID=
NUXT_SPOTIFY_CLIENT_SECRET=
# База данных: пусто — локальный файл .data/audio.db.
# На Vercel обязательно Turso (файловая система там только для чтения): libsql://<db>.turso.io
NUXT_DB_URL=
NUXT_DB_AUTH_TOKEN=
